local function clearESP()
    for _, list in pairs(getgenv().Config.ESP.Cache) do
        for _, d in pairs(list) do
            pcall(function() d:Remove() end)
        end
    end
    getgenv().Config.ESP.Cache = {}
end

local function newDraw(type, props)
    local d = Drawing.new(type)
    for k, v in pairs(props) do
        d[k] = v
    end
    return d
end

RunService.RenderStepped:Connect(function()
    if not getgenv().Config.ESP.Enabled then clearESP(); return end

    for _, p in ipairs(Players:GetPlayers()) do
        pcall(function()
            -- Remove cache if player or character missing
            if (not p) or (not p.Parent) or (not p.Character) or (not p.Character.Parent) then
                if getgenv().Config.ESP.Cache[p] then
                    for _, d in pairs(getgenv().Config.ESP.Cache[p]) do pcall(function() d:Remove() end) end
                    getgenv().Config.ESP.Cache[p] = nil
                end
                return
            end

            -- 1. Cria Cache
            if not getgenv().Config.ESP.Cache[p] then
                getgenv().Config.ESP.Cache[p] = {
                    Box = newDraw("Square", {Thickness = 1.5, Color = Color3.new(1,0,0), Filled = false, ZIndex=2}),
                    Tracer = newDraw("Line", {Thickness = 1, Color = Color3.new(1,0,0), ZIndex=1}),
                    Name = newDraw("Text", {Size = 14, Center = true, Outline = true, Color = Color3.new(1,1,1), ZIndex=3}),
                    HP = newDraw("Text", {Size = 12, Center = true, Outline = true, Color = Color3.new(0,1,0), ZIndex=3})
                }
            end

            local c = getgenv().Config.ESP.Cache[p]

            -- 2. RESET TOTAL (Anti-Ghosting)
            c.Box.Visible = false
            c.Tracer.Visible = false
            c.Name.Visible = false
            c.HP.Visible = false

            -- 3. Validações
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                if getgenv().Config.ESP.TeamCheck and p.Team == LocalPlayer.Team then
                    -- ensure removal/hide when same team
                    c.Box.Visible = false; c.Tracer.Visible = false; c.Name.Visible = false; c.HP.Visible = false
                    return
                end

                local root = p.Character.HumanoidRootPart
                local head = p.Character:FindFirstChild("Head") or root

                -- prefer using head for on-screen check (more accurate)
                local headVec, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local rootVec, rootOnScreen = Camera:WorldToViewportPoint(root.Position)

                -- Determine on-screen and in-front status
                local onScreen = (headOnScreen and headVec.Z > 0) or (rootOnScreen and rootVec.Z > 0)
                local vec = (headOnScreen and headVec) or rootVec

                -- 4. Só desenha se estiver NA TELA e à frente da câmera
                if onScreen and vec.Z > 0 then
                    local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                    local legPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                    local h = math.abs(headPos.Y - legPos.Y)
                    if h <= 0 then h = 20 end
                    local w = h / 1.8

                    -- Box
                    if getgenv().Config.ESP.Box then
                        c.Box.Visible = true
                        c.Box.Size = Vector2.new(w, h)
                        c.Box.Position = Vector2.new(vec.X - w/2, vec.Y - h/2)
                    end
                    -- Tracer
                    if getgenv().Config.ESP.Tracer then
                        c.Tracer.Visible = true
                        c.Tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                        c.Tracer.To = Vector2.new(vec.X, vec.Y + h/2)
                    end
                    -- Nome
                    if getgenv().Config.ESP.Name then
                        c.Name.Visible = true
                        local dist = getgenv().Config.ESP.Dist and string.format(" [%d m]", math.floor(vec.Z)) or ""
                        c.Name.Text = p.DisplayName .. dist
                        c.Name.Position = Vector2.new(vec.X, vec.Y - h/2 - 16)
                    end
                    -- HP
                    if getgenv().Config.ESP.HP then
                        c.HP.Visible = true
                        c.HP.Text = math.floor(p.Character.Humanoid.Health).."%"
                        c.HP.Position = Vector2.new(vec.X, vec.Y + h/2 + 2)
                        local hpNorm = math.clamp(p.Character.Humanoid.Health / p.Character.Humanoid.MaxHealth, 0, 1)
                        c.HP.Color = Color3.fromHSV(hpNorm * 0.3, 1, 1)
                    end
                else
                    -- Not on screen or behind camera: hide visuals
                    c.Box.Visible = false
                    c.Tracer.Visible = false
                    c.Name.Visible = false
                    c.HP.Visible = false
                end
            else
                -- character missing or dead: ensure removal
                if getgenv().Config.ESP.Cache[p] then
                    for _, d in pairs(getgenv().Config.ESP.Cache[p]) do pcall(function() d:Remove() end) end
                    getgenv().Config.ESP.Cache[p] = nil
                end
            end
        end)
    end
end)

