-- Improved visibility check (uses Config.Aim.WallCheck and RaycastParams blacklist)
local function isVisiblePart(part)
    if not getgenv().Config.Aim.WallCheck then return true end
    if not part or not part.Parent then return false end
    local cam = workspace.CurrentCamera
    local origin = cam and cam.CFrame.Position or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position) or Vector3.new()

    local dir = (part.Position - origin)
    if dir.Magnitude == 0 then return true end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    -- Exclude additional instances if necessary (tools, visuals)
    local result = Workspace:Raycast(origin, dir.Unit * dir.Magnitude, params)
    if not result then return true end
    return result.Instance and result.Instance:IsDescendantOf(part.Parent)
end

-- FOV angle check (degrees)
local function isInFovAngle(pos, fovDeg)
    local cam = workspace.CurrentCamera
    if not cam then return false end
    local toTarget = (pos - cam.CFrame.Position)
    if toTarget.Magnitude == 0 then return true end
    local forward = cam.CFrame.LookVector
    local cosAngle = forward:Dot(toTarget.Unit)
    if cosAngle > 1 then cosAngle = 1 end
    if cosAngle < -1 then cosAngle = -1 end
    local angleDeg = math.deg(math.acos(cosAngle))
    return angleDeg <= (fovDeg / 2)
end

-- Pick target by angle-based FOV first, fallback to screen-space distance
local function getTarget()
    local target = nil
    local bestMetric = 1e9
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            if getgenv().Config.Aim.TeamCheck and p.Team == LocalPlayer.Team then goto continue end
            local part = p.Character:FindFirstChild(getgenv().Config.Aim.Part) or p.Character:FindFirstChild("HumanoidRootPart")
            if part then
                if getgenv().Config.Aim.WallCheck and not isVisiblePart(part) then goto continue end
                -- angle check if FOV enabled
                if getgenv().Config.Aim.FOV.Enabled then
                    if not isInFovAngle(part.Position, getgenv().Config.Aim.FOV.Radius) then goto continue end
                    -- prefer smaller angle
                    local cam = workspace.CurrentCamera
                    local toTarget = (part.Position - cam.CFrame.Position).Unit
                    local angle = math.deg(math.acos(math.clamp(cam.CFrame.LookVector:Dot(toTarget), -1, 1)))
                    if angle < bestMetric then bestMetric = angle; target = part end
                else
                    -- fallback: use screen-space distance (original behavior)
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen and pos.Z > 0 then
                        local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                        local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if dist < bestMetric then bestMetric = dist; target = part end
                    end
                end
            end
        end
        ::continue::
    end
    return target
end

-- Aim helper: rage snap or legit lerp
local function aimAtPart(part)
    if not part or not part.Parent or not workspace.CurrentCamera then return end
    local cam = workspace.CurrentCamera
    local targetPos = part.Position
    if getgenv().Config.Aim.Rage then
        cam.CFrame = CFrame.new(cam.CFrame.Position, targetPos)
    elseif getgenv().Config.Aim.Legit then
        local speed = getgenv().Config.Aim.Speed or 0.5
        cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, targetPos), math.clamp(speed, 0.01, 1))
    end
end

